{
  "rules": {
    ".read": false,
    ".write": false,

    "contador_global": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || (newData.val() > data.val() && newData.val() <= data.val() + 1))"
    },

    "rotas_total": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || (newData.val() > data.val() && newData.val() <= data.val() + 1))"
    },

    "rotas_registradas": {
      "$rota": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      }
    },

    "lotes": {
      "$rota": {
        ".read": "auth != null",
        ".write": "auth != null",

        "pin": {
          ".validate": "newData.hasChildren(['hash','salt','alg'])",
          "hash": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "salt": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "alg": { ".validate": "newData.isString() && (newData.val() === 'sha256' || newData.val() === 'simples')" },
          "ts": { ".validate": "newData.isNumber()" },
          "$outro": { ".validate": false }
        },

        "faixas": {
          "ts": { ".validate": "newData.isNumber()" },
          "ruas": {
            "$idx": {
              "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "nome": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "fragmentar": { ".validate": "newData.isBoolean()" },
              "maxPar": { ".validate": "newData.isNumber()" },
              "maxImpar": { ".validate": "newData.isNumber()" },
              "corteManualPar": { ".validate": "newData.isNumber()" },
              "corteManualImpar": { ".validate": "newData.isNumber()" },
              "cores": {
                "$campo": {
                  ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/)"
                }
              },
              "cepVistos": {
                "$cep": { ".validate": "newData.isNumber()" }
              },
              "cepEndereco": {
                "$numero": {
                  "$cep": { ".validate": "newData.isNumber() && newData.val() >= 0" }
                }
              },
              "faixaCep": {
                "$cep": {
                  ".validate": "newData.hasChildren(['min','max','n'])",
                  "min": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "max": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "$outro": { ".validate": false }
                }
              },
              "$outro": { ".validate": false }
            }
          },
          "$outro": { ".validate": false }
        },

        "lista": {
          "$data": {
            ".validate": "$data.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "texto": { ".validate": "newData.isString() && newData.val().length <= 500000" },
            "ts": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          }
        },

        "pacotes": {
          "$codigo": {
            "separado": { ".validate": "newData.isBoolean()" },
            "entregue": { ".validate": "newData.isBoolean()" },
            "devolvido": { ".validate": "newData.isBoolean()" },
            "ts": { ".validate": "newData.isNumber()" },
            "dia": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "$outro": { ".validate": false }
          }
        },

        "entregas": {
          "$data": {
            ".validate": "$data.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$codigo": {
              "rua": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "numero": { ".validate": "(newData.isString() && newData.val().length <= 20) || newData.isNumber()" },
              "nome": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "chave": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "quemRecebeu": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "ts": { ".validate": "newData.isNumber()" },
              "fotos": {
                "$slot": {
                  ".validate": "newData.isString() && newData.val().beginsWith('https://res.cloudinary.com/')"
                }
              },
              "fotoPacoteUrl": {
                ".validate": "newData.isString() && newData.val().beginsWith('https://res.cloudinary.com/')"
              },
              "$outro": { ".validate": false }
            }
          }
        },

        "fachadas_permanentes": {
          "$chave": {
            "rua": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "numero": { ".validate": "(newData.isString() && newData.val().length <= 20) || newData.isNumber()" },
            "fotoFachadaUrl": {
              ".validate": "newData.isString() && newData.val().beginsWith('https://res.cloudinary.com/')"
            },
            "ts": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          }
        },

        "$outro": { ".validate": false }
      }
    }
  }
}
